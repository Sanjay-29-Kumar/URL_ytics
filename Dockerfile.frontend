FROM node:22-alpine

WORKDIR /app

COPY package*.json ./
RUN npm install
COPY . .

# Pass VITE_API_URL from GitHub Actions during build
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL

RUN npm run build
RUN npm install -g serve

EXPOSE 5173

# Execute via shell to bind to Render's dynamic PORT
CMD sh -c "serve -s dist -l ${PORT:-5173}"